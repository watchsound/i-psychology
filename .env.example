# Copy to .env (git-ignored) and fill in real values before running
# any script that touches the LLM router.
#
# Which env vars are read depends on configs/llm.yaml — each provider's
# `api_key_env` field names the variable that holds its key.

# Alibaba Tongyi (DashScope) — qwen-turbo / qwen-max
ALIBABA_TONGYI_API_KEY=

# Anthropic — claude-haiku-4-5 / claude-opus-4-7
ANTHROPIC_API_KEY=

# OpenAI — gpt-4o-mini / gpt-4o
OPENAI_API_KEY=
